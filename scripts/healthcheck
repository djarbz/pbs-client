#!/usr/bin/env bash
# shellcheck shell=bash

# Source the environment variables exported by the entrypoint
# Shellcheck(SC1091): Not following: /tmp/pbs-client.env was not specified as input (see shellcheck -x).
# shellcheck disable=SC1091
source "/tmp/pbs-client.env"

# Default to 25 hours (1500 minutes) to allow for daily backups with slight drift.
# Users can override this by setting PBC_HEALTHCHECK_MAX_AGE_MIN.
MAX_AGE_MINS=${PBC_HEALTHCHECK_MAX_AGE_MIN:-1500}

# 1. Check if a backup is currently running
if pidof proxmox-backup-client >/dev/null 2>&1; then
  echo "Healthy: A backup is currently in progress."
  exit 0
fi

# 2. Check if the run file exists
if [ ! -f "${PBC_LAST_RUN_FILE}" ]; then
  echo "Unhealthy: Backup run file not found at ${PBC_LAST_RUN_FILE}. No backup has completed yet."
  exit 1
fi

# 3. Check if the file is older than the max age using find
if [[ -z $(find "${PBC_LAST_RUN_FILE}" -mmin -"${MAX_AGE_MINS}" -print) ]]; then
  echo "Unhealthy: Last backup was more than ${MAX_AGE_MINS} minutes ago."
  echo "Last run recorded: $(cat "${PBC_LAST_RUN_FILE}")"
  exit 1
fi

# 4. Everything is good
echo "Healthy: Last backup ran at $(cat "${PBC_LAST_RUN_FILE}")"
exit 0
